rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all files
      allow read;
      
      // Allow authenticated users to write to videos, audios, and pdfs folders
      // For more security, you can restrict this to specific users or use Firestore verification
      allow write: if request.auth != null;
    }
  }
}
